@model CasaApuestas.Models.ViewModels.HomeViewModel
@using System.Globalization
@using CasaApuestas.Models.ViewModels
@{
    ViewData["Title"] = "Partidos";
}

@{
    // Renderiza una fila de partido. Cuotas con punto decimal (cultura invariante).
    // Las cuotas se VEN pero todavia no se pueden pulsar: apostar es RF9 (por eso van "disabled").
    void Fila(PartidoFilaViewModel m)
    {
        <div class="match">
            <div class="time">
                @if (m.EnVivo) { <b>En vivo</b> }
                @m.Hora
            </div>
            <div class="teams">
                @foreach (var t in new[] { m.Local, m.Visitante })
                {
                    <div class="t">
                        @if (!string.IsNullOrWhiteSpace(t.EscudoUrl))
                        {
                            <img class="cat-sh sm" src="@t.EscudoUrl" alt="" loading="lazy" />
                        }
                        else
                        {
                            <span class="cat-sh sm" aria-hidden="true">@t.Iniciales</span>
                        }
                        <a class="t-link" href="@Url.Action("Detalle", "Partidos", new { id = m.IdPartido })">@t.Nombre</a>
                        @if (t.Goles is int g) { <span class="sc">@g</span> }
                    </div>
                }
            </div>
            <div class="right">
                @if (m.MercadosExtra > 0) { <a class="more" href="@Url.Action("Detalle", "Partidos", new { id = m.IdPartido })" title="Ver todos los mercados">+@m.MercadosExtra</a> }
                <div class="odds">
                    @foreach (var c in m.Cuotas)
                    {
                        <button type="button" class="odd" disabled>
                            <small>@c.Etiqueta</small><b>@(c.Valor is decimal v ? v.ToString("0.00", CultureInfo.InvariantCulture) : "–")</b>
                        </button>
                    }
                </div>
            </div>
        </div>
    }
}

<div class="chips">
    <button type="button" class="chip on">Todo</button>
    <button type="button" class="chip">Fútbol</button>
    <button type="button" class="chip">Jugadores</button>
    <button type="button" class="chip">Datos</button>
    <button type="button" class="chip">En vivo</button>
</div>

<div class="promos">
    <div class="promo a"><h2>Recarga hoy y recibe saldo extra de pruebas</h2><span>Lo quiero</span></div>
    <div class="promo b"><h2>Gana con dos goles de ventaja en tu apuesta</h2><span>Ver cómo</span></div>
</div>

<div class="tabs" role="tablist">
    <button type="button" class="tab on">En vivo y próximo</button>
    <button type="button" class="tab">Competición</button>
    <button type="button" class="tab">Todo fútbol</button>
</div>

@if (Model.Error is not null)
{
    <section class="sec solo">
        <div class="cat-empty" role="alert"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i><p>@Model.Error</p></div>
    </section>
}
else if (Model.SinPartidos)
{
    <section class="sec solo">
        <div class="cat-empty"><i class="bi bi-calendar-x" aria-hidden="true"></i><p>No hay partidos en vivo ni programados por ahora.</p></div>
    </section>
}
else
{
    @* Una seccion sin partidos no se muestra. *@
    @if (Model.EnVivo.Count > 0)
    {
        <section class="sec">
            <div class="sec-head"><span class="tag">EN VIVO</span>En vivo ahora</div>
            @foreach (var grupo in Model.EnVivo)
            {
                <div class="comp">@grupo.Titulo</div>
                @foreach (var p in grupo.Partidos) { Fila(p); }
            }
        </section>
    }

    @if (Model.Proximos.Count > 0)
    {
        <section class="sec solo">
            <div class="sec-head"><span class="tag p">PRÓXIMO</span>Comenzando pronto</div>
            @foreach (var grupo in Model.Proximos)
            {
                <div class="comp">@grupo.Titulo</div>
                @foreach (var p in grupo.Partidos) { Fila(p); }
            }
        </section>
    }
}

@section Scripts {
    <script>
        // Interacción visual de pestañas y chips (las cuotas aún no son interactivas: apostar es RF9).
        document.addEventListener('click', function (e) {
            const tab = e.target.closest('.tab');
            const chip = e.target.closest('.chip');
            if (tab) {
                document.querySelectorAll('.tab').forEach(function (t) { t.classList.toggle('on', t === tab); });
            } else if (chip) {
                document.querySelectorAll('.chip').forEach(function (c) { c.classList.toggle('on', c === chip); });
            }
        });
    </script>
}
