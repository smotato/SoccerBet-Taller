@{
    ViewData["Title"] = "Iniciar sesión";
    // Pantalla a pantalla completa (sin barra de navegación): usa su propio layout.
    Layout = "_AuthLayout";
}

@* Token antiforgery (input oculto + cookie). El script lo envía en el encabezado RequestVerificationToken. *@
@Html.AntiForgeryToken()

<section class="login">
    <partial name="_AuthSide" />
    <div class="form">
        <div class="card">
            <h2>Iniciar sesión</h2>
            <p class="sub">Entra con tu correo y contraseña.</p>
            <label for="Username">Correo electrónico</label>
            <div class="fld"><i class="bi bi-envelope ic" aria-hidden="true"></i><input id="Username" type="email" placeholder="nombre@correo.com" autocomplete="email"></div>
            <label for="Password">Contraseña</label>
            <div class="fld eye"><i class="bi bi-lock ic" aria-hidden="true"></i><input id="Password" type="password" placeholder="Tu contraseña" autocomplete="current-password"><button type="button" class="eye-btn" id="btnVerPass" aria-label="Mostrar contraseña"><i class="bi bi-eye" aria-hidden="true"></i></button></div>
            <button type="button" id="btnLogin" class="btn-pink">Entrar</button>
            <p class="foot"><a href="#">Olvidé mi contraseña</a></p>
            <div class="or" aria-hidden="true">o</div>
            <p class="foot"><a asp-action="Registro">Crear cuenta</a></p>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        async function iniciarSesion() {
            const username = document.getElementById('Username').value;
            const password = document.getElementById('Password').value;

            if (Loader.isBusy()) return; // ya hay una validación en curso
            Loader.show();

            try {
                const response = await fetch('/Account/ValidarLogin', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ username: username, password: password })
                });

                // 400 = token antiforgery inválido o vencido (la página lleva abierta mucho tiempo o se reinició la app).
                if (response.status === 400) {
                    Loader.hide();
                    Swal.fire({
                        icon: 'warning',
                        title: 'La página caducó',
                        text: 'Recárgala e inténtalo de nuevo.',
                        confirmButtonColor: '#1A7FE8'
                    });
                    return;
                }

                const data = await response.json();

                if (data.exito) {
                    // Login correcto: se redirige al home sin alerta. El loader NO se oculta:
                    // sigue visible hasta que el navegador cambia de página.
                    // Si venía redirigido por [Authorize] o desde el cupón (?ReturnUrl=...), vuelve a esa página.
                    // El destino lo valida el SERVIDOR con Url.IsLocalUrl (solo rutas locales): si no era local, se usa el home.
                    const destino = @Json.Serialize((ViewData["ReturnUrl"] as string) ?? "/Home/Index");
                    window.location.href = destino;
                } else {
                    Loader.hide(); // antes del SweetAlert, que quedaría por debajo del loader
                    Swal.fire({
                        icon: 'error',
                        title: data.mensaje || 'Datos Incorrectos!',
                        confirmButtonColor: '#1A7FE8'
                    });
                }
            } catch (error) {
                Loader.hide();
                Swal.fire({
                    icon: 'error',
                    title: 'Error de conexión',
                    text: 'No se pudo contactar al servidor.'
                });
            }
        }

        document.getElementById('btnLogin').addEventListener('click', iniciarSesion);
        // Ojo: solo alterna la visibilidad de la contraseña en pantalla (no cambia el envío).
        document.getElementById('btnVerPass').addEventListener('click', function () {
            const input = document.getElementById('Password');
            const ver = input.type === 'password';
            input.type = ver ? 'text' : 'password';
            this.firstElementChild.className = ver ? 'bi bi-eye-slash' : 'bi bi-eye';
            this.setAttribute('aria-label', ver ? 'Ocultar contraseña' : 'Mostrar contraseña');
        });
        // Enter dentro de los campos también envía el formulario
        document.querySelectorAll('#Username, #Password').forEach(function (el) {
            el.addEventListener('keydown', function (e) { if (e.key === 'Enter') iniciarSesion(); });
        });
    </script>
}
