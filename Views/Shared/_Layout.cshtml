<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>SoccerBet · @ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet" />
    @* Bootstrap Icons (MIT, gratuita): iconos como fuente. Se usan como <i class="bi bi-nombre"></i> *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/loader.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/catalogo.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
    <header class="app-header">
        <div class="bar">
            <button class="burger" id="burger" aria-label="Mostrar u ocultar menú" aria-expanded="true"><span></span><span></span><span></span></button>
            <a class="brand disp" asp-controller="Home" asp-action="Index"><i class="bi bi-trophy-fill" aria-hidden="true"></i>SoccerBet</a>
            <nav class="main-nav" aria-label="Principal">
                <a class="on" asp-controller="Home" asp-action="Index">Deporte</a>
                <a href="#">En vivo</a>
                <a href="#">Mis apuestas</a>
                <a href="#">Promociones</a>
                <a href="#">Ayuda</a>
            </nav>
            @* Saldo/avatar/salir si hay sesion de cliente; Iniciar sesion/Registrarse si no. Ver ViewComponents/WalletViewComponent.cs *@
            @await Component.InvokeAsync("Wallet")
        </div>
    </header>

    <div class="shell">
        <aside class="side" aria-label="Menú">
            <div class="search"><input placeholder="Buscar equipo o liga" aria-label="Buscar"><button type="button" aria-label="Buscar"><i class="bi bi-search" aria-hidden="true"></i></button></div>
            <h3>Popular</h3>
            <a href="#"><i class="bi bi-receipt" aria-hidden="true"></i>Mis apuestas</a>
            <a href="#"><i class="bi bi-gift" aria-hidden="true"></i>Apuestas gratuitas</a>
            <a href="#"><i class="bi bi-star" aria-hidden="true"></i>Destacados</a>
            <a href="#"><i class="bi bi-broadcast" aria-hidden="true"></i>En vivo ahora</a>
            <a href="#"><i class="bi bi-stopwatch" aria-hidden="true"></i>Comenzando pronto</a>
            <h3>Competiciones</h3>
            <a class="on" asp-controller="Catalogo" asp-action="Equipos"><i class="bi bi-trophy" aria-hidden="true"></i>Liga colombiana</a>
            <a class="sub" asp-controller="Catalogo" asp-action="Equipos">Equipos y plantillas</a>
            <a class="sub" href="#">Datos y resultados</a>
            <a class="sub" href="#">Apuestas de jugadores</a>
            <a class="sub" href="#">Tabla de posiciones</a>
        </aside>

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/loader.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
