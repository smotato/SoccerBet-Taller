@* Panel izquierdo compartido por Login y Registro. El "ticket" es decorativo (partido de ejemplo): aria-hidden. *@
<div class="side">
    <div class="brand"><i class="bi bi-trophy-fill" aria-hidden="true"></i>SoccerBet</div>

    <div class="hero">
        <h1>Juega<br />la fecha.</h1>

        <div class="ticket" aria-hidden="true">
            <div class="ticket-head"><span class="live-dot"></span>Hoy 18:00 · Liga BetPlay</div>
            <div class="ticket-teams">
                <span class="t"><span class="sh" style="background:#2E7D4F">NAL</span>Nacional</span>
                <span class="vs">vs</span>
                <span class="t"><span class="sh" style="background:#1F4E9C">MIL</span>Millonarios</span>
            </div>
            <div class="ticket-odds">
                <span><small>1</small><b>2.35</b></span>
                <span class="pick"><small>X</small><b>3.10</b></span>
                <span><small>2</small><b>2.90</b></span>
            </div>
        </div>

        <ul class="perks">
            <li><i class="bi bi-trophy" aria-hidden="true"></i>Liga BetPlay</li>
            <li><i class="bi bi-wallet2" aria-hidden="true"></i>Saldo de pruebas</li>
            <li><i class="bi bi-shield-check" aria-hidden="true"></i>Sin dinero real</li>
        </ul>
    </div>

    <p class="legal">Pagos en modo prueba con Wompi. Solo mayores de 18 años.</p>
</div>
